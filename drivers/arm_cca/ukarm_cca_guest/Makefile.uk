$(eval $(call addlib_s,libukarm_cca_guest,$(CONFIG_LIBUKARM_CCA_GUEST)))

CINCLUDES-$(CONFIG_LIBUKARM_CCA_GUEST)   += -I$(LIBUKARM_CCA_GUEST_BASE)/include
CXXINCLUDES-$(CONFIG_LIBUKARM_CCA_GUEST) += -I$(LIBUKARM_CCA_GUEST_BASE)/include

LIBUKARM_CCA_GUEST_CINCLUDES-y += -I$(UK_PLAT_COMMON_BASE)/include

LIBUKARM_CCA_GUEST_SRCS-y += $(LIBUKARM_CCA_GUEST_BASE)/arm_cca_guest.c

ifneq ($(filter y,$(CONFIG_LIBUKARM_CCA_GUEST_TEST) $(CONFIG_LIBUKTEST_ALL)),)
LIBUKARM_CCA_GUEST_SRCS-y += $(LIBUKARM_CCA_GUEST_BASE)/tests/test_arm_cca_guest.c
endif
